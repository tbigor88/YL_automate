#!/usr/bin/env python3
import yaml
from jinja2 import Environment, FileSystemLoader
from collections import defaultdict

YAML_FILE = "tenants_dynamic.yaml"
TEMPLATE_FILE = "tenant-template-no-comments.j2"

def _interfaces_iter(tenant):
    for i in tenant.get("INTERFACES", []):
        if isinstance(i, dict):
            yield i

def _leaves(tenant):
    seen = set()
    out = []
    for i in _interfaces_iter(tenant):
        lf = i.get("leaf") or i.get("LEAF")
        if lf and lf not in seen:
            seen.add(lf)
            out.append(lf)
    return out

def _normalize_intfs_for_leaf(tenant, leaf):
    norm = []
    for i in _interfaces_iter(tenant):
        lf = i.get("leaf") or i.get("LEAF")
        if lf == leaf:
            norm.append({
                "iface": i.get("iface") or i.get("IFACE"),
                "description": i.get("description") or i.get("DESCRIPTION"),
                "ipv6_prefix_64": i.get("ipv6_prefix_64") or i.get("IPV6_PREFIX_64"),
                "leaf": lf,
            })
    return norm

def main():
    with open(YAML_FILE) as f:
        data = yaml.safe_load(f) or {}
    tenants = data.get("tenants", [])
    if not tenants:
        print("⚠️ No tenants found in tenants_dynamic.yaml")
        return

    env = Environment(loader=FileSystemLoader("."), trim_blocks=True, lstrip_blocks=True)
    template = env.get_template(TEMPLATE_FILE)

    combined_blocks = []
    leaf_outputs = defaultdict(list)

    for tenant in tenants:
        rd_map = tenant.get("ROUTE_DISTINGUISHER_MAP", {}) or {}
        leaves = _leaves(tenant)

        # If no leaves, just render as-is (unlikely in this workflow)
        if not leaves:
            combined_blocks.append(template.render(**tenant))
            continue

        # Render one block per leaf (inject per-leaf RD + filtered interfaces)
        for leaf in leaves:
            intfs = _normalize_intfs_for_leaf(tenant, leaf)
            if not intfs:
                continue
            rd = rd_map.get(leaf, "")  # per-leaf RD is authoritative
            t_ctx = dict(tenant)
            t_ctx["INTERFACES"] = intfs
            t_ctx["ROUTE_DISTINGUISHER"] = rd
            rendered = template.render(**t_ctx)
            leaf_outputs[leaf].append(rendered)
            combined_blocks.append(rendered)

    with open("all-tenants-dynamic.conf", "w") as f:
        f.write("\n".join(b.strip() for b in combined_blocks if b).strip() + "\n")
    print("📦 Combined config saved as all-tenants-dynamic.conf")

    for leaf, blocks in sorted(leaf_outputs.items()):
        filename = f"tenants-{leaf}.conf"
        with open(filename, "w") as f:
            f.write("\n".join(b.strip() for b in blocks if b).strip() + "\n")
        print(f"📄 Per-leaf config saved as {filename}")

if __name__ == "__main__":
    main()
