#!/bin/bash
set -euo pipefail

LEAF_FILE="leaf-nodes.txt"
USER="jnpr"
PASS="pass123"
TARGET_ALIAS="${1:-}"

[ -f "$LEAF_FILE" ] || { echo "❌ $LEAF_FILE not found"; exit 1; }

# Build target list (alias + IP per line)
if [ -n "$TARGET_ALIAS" ]; then
  targets="$(grep -w "$TARGET_ALIAS" "$LEAF_FILE" || true)"
  [ -n "$targets" ] || { echo "❌ Leaf alias $TARGET_ALIAS not in $LEAF_FILE"; exit 1; }
else
  echo "Available leaf nodes:"
  nl -w1 -s') ' "$LEAF_FILE"
  read -rp "Select leaf node(s) to deploy to (e.g. 1 3 or 'all'): " choices
  if [[ "$choices" == "all" ]]; then
    targets="$(cat "$LEAF_FILE")"
  else
    targets=""
    for c in $choices; do
      [[ "$c" =~ ^[0-9]+$ ]] || { echo "❌ Invalid choice: $c"; exit 1; }
      line="$(sed -n "${c}p" "$LEAF_FILE")"
      [ -n "$line" ] || { echo "❌ Invalid index: $c"; exit 1; }
      targets+="$line"$'\n'
    done
  fi
fi

overall_rc=0

while IFS=$' \t' read -r alias ip; do
  [ -n "${alias:-}" ] || continue

  CONF_LOCAL="tenants-${alias}.conf"
  if [ ! -f "$CONF_LOCAL" ]; then
    echo "⚠️  Skipping $alias ($ip): $CONF_LOCAL not found."
    overall_rc=1
    continue
  fi

  REMOTE_SET="/var/tmp/${alias}-tenant.set"
  echo "📤 Copying $CONF_LOCAL → $alias ($ip):$REMOTE_SET"
  sshpass -p "$PASS" scp -o StrictHostKeyChecking=no "$CONF_LOCAL" "$USER@$ip:$REMOTE_SET"

  echo "🛠️  Configure + commit on $alias ($ip)…"
  commit_out="$(
    sshpass -p "$PASS" ssh -o StrictHostKeyChecking=no "$USER@$ip" <<EOF
set cli screen-length 0
configure
load set $REMOTE_SET
commit
exit
EOF
  )" || true   # don't let SSH nonzero kill the script; we parse output instead

  # Detect Junos commit failure text
  if echo "$commit_out" | grep -qiE 'error: commit failed|configuration check-out failed|statements constraint check failed'; then
    echo "❌ $alias ($ip): NOT successful — commit failed."
    echo "----- commit output begin -----"
    echo "$commit_out"
    echo "------ commit output end ------"
    echo "↩️  Rolling back on $alias ($ip)…"
    sshpass -p "$PASS" ssh -o StrictHostKeyChecking=no "$USER@$ip" <<'EOF'
configure
rollback
exit
EOF
    overall_rc=1
  else
    echo "✅ $alias ($ip): committed successfully."
  fi
done <<< "$targets"

exit $overall_rc
Description
Automates the deployment of the dynamically generated tenant configuration (all-tenants-dynamic.conf) to one or more Juniper leaf switches.

It reads the list of available leaf nodes from leaf-nodes.txt, presents an interactive selection menu, and pushes the configuration via SSH using non-interactive credentials.

This script ensures consistent, repeatable, and error-free configuration delivery across multiple devices in the EVPN-VXLAN AI fabric.
Functionality Overview
Step 1: Validate Input Files
1.1) Checks for the existence of:
- leaf-nodes.txt (list of available leaf nodes)
- all-tenants-dynamic.conf (configuration file generated by generate_dynamic_tenants.py)
  1.2) If either file is missing, the script exits with an error message.
Step 2: Display Leaf Node Menu
2.1) Reads each line from leaf-nodes.txt in the format:
- <LEAF_ALIAS> <LEAF_IP>
  2.2) Displays all entries as a numbered list for user selection.
Step 3: Prompt For User Selection
Prompts the user to select one or more leaf nodes by number (e.g., 1, or 1 3) or all at once (all).
Step 4: Build Target List
4.1) If all is chosen, every leaf listed in the file becomes a deployment target.

4.2) If numeric choices are provided, the script matches them with corresponding lines from leaf-nodes.txt.
Step 5: Deploy Configuration
Iterates over the selected leaf targets from leaf-nodes.txt (via menu or a single alias argument). For each target <ALIAS> <IP>:
5.1) Selects per-leaf config file: tenants-<ALIAS>.conf.

5.2) Copies the file to the switch (SCP) as /var/tmp/<ALIAS>-tenant.set using sshpass with USER and PASS defined in the script.

5.3) Opens one CLI session and runs:
configure
load set /var/tmp/<ALIAS>-tenant.set
commit
exit
5.4) Parses the commit output locally:
- If commit fails (detects error: commit failed / constraint errors):
  → a quick follow-up session runs:
configure
rollback
exit
Reports NOT successful for that device.

