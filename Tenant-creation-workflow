#!/usr/bin/env python3
import yaml
import os
import ipaddress
import re
from tabulate import tabulate
from collections import defaultdict

FABRIC_MAP_FILE = "fabric-map.txt"
RESOURCES_FILE = "resources.txt"
YAML_OUT = "tenants_dynamic.yaml"


def load_fabric_map():
    server_gpu = defaultdict(lambda: defaultdict(list))  # server -> gpu -> [(leaf, iface, desc)]
    server_gpus = defaultdict(set)                       # server -> {gpu indices}
    leaf_router_id = {}                                  # leaf -> router-id

    with open(FABRIC_MAP_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) < 5:
                continue

            leaf, router_id, iface, server, server_iface = parts[:5]
            leaf_router_id[leaf] = router_id

            gnum = None
            s_if = server_iface.lower()
            if s_if.startswith("gpu") and "_eth" in s_if:
                try:
                    gnum = int(s_if.split("_eth")[0].replace("gpu", ""))
                except Exception:
                    gnum = None
            if gnum is None:
                continue

            desc = f"to.{server}:{server_iface}"
            server_gpu[server][gnum].append((leaf, iface, desc))
            server_gpus[server].add(gnum)

    for s in list(server_gpus.keys()):
        server_gpus[s] = sorted(server_gpus[s])

    return server_gpu, server_gpus, leaf_router_id


def load_ipv6_base():
    with open(RESOURCES_FILE) as f:
        content = f.read()
    m = re.search(r"IPv6\s*range:\s*([0-9A-Fa-f:]+\/\d+)", content)
    if not m:
        raise ValueError("IPv6 base range not found in resources.txt (expected 'IPv6 range: FC00:200::/48').")
    return ipaddress.ip_network(m.group(1))


def next_tenant_index(existing):
    return len(existing) + 1


def _extract_rd_numbers_from_existing(tenants):
    max_num = 2000
    for t in tenants:
        rdmap = t.get("ROUTE_DISTINGUISHER_MAP", {})
        if isinstance(rdmap, dict):
            for v in rdmap.values():
                if isinstance(v, str) and ":" in v:
                    try:
                        num = int(v.split(":")[1])
                        max_num = max(max_num, num)
                    except Exception:
                        pass
    return max_num


def print_available_servers(servers, server_gpus):
    print("\nAvailable servers:")
    for i, s in enumerate(servers, 1):
        print(f"{i}) {s}: GPUs {server_gpus[s]}")


def main():
    server_gpu, server_gpus, leaf_router_id = load_fabric_map()
    base_prefix = load_ipv6_base()

    tenants = []
    vni_counter, rd_counter, vrf_counter = 20001, 2001, 20001
    if os.path.exists(YAML_OUT):
        with open(YAML_OUT) as f:
            existing = yaml.safe_load(f) or {}
            tenants = existing.get("tenants", [])
            if tenants:
                try:
                    vni_counter = max(int(t.get("VNI", 20000)) for t in tenants) + 1
                except ValueError:
                    vni_counter = 20001
                rd_counter = _extract_rd_numbers_from_existing(tenants) + 1
                max_vrf_left = 20000
                for t in tenants:
                    vt = t.get("VRF_TARGET")
                    if isinstance(vt, str) and ":" in vt:
                        try:
                            left = int(vt.split(":")[0])
                            max_vrf_left = max(max_vrf_left, left)
                        except Exception:
                            pass
                vrf_counter = max_vrf_left + 1

    idx = next_tenant_index(tenants)
    print(f"\n--- Tenant {idx} ---")
    tenant_name = input(f"Tenant name (default Tenant-{idx}): ").strip() or f"Tenant-{idx}"

    base_int = int(base_prefix.network_address)
    tenant_net = ipaddress.ip_network((base_int + (idx << (128 - 56)), 56))
    prefix_56 = str(tenant_net)

    interfaces = []
    used_servers = set()
    servers = sorted(
        server_gpus.keys(),
        key=lambda s: (not s.upper().startswith("H100"), not s.upper().startswith("MI300"), s.lower())
    )

    def compute_prefix64(tenant_net, offset_index):
        base_addr_int = int(tenant_net.network_address)
        subnet_addr_int = base_addr_int + (offset_index << 64)
        subnet_addr = ipaddress.IPv6Address(subnet_addr_int)
        return ipaddress.IPv6Network(f"{subnet_addr}/64", strict=False)

    while True:
        print_available_servers(servers, server_gpus)
        choice = input("Select server (blank to finish): ").strip()
        if choice == "":
            if not interfaces:
                print("⚠️ You must add at least one GPU.")
                continue
            break

        if not choice.isdigit() or not (1 <= int(choice) <= len(servers)):
            print("❌ Invalid selection.")
            continue

        srv = servers[int(choice) - 1]
        gset = server_gpus[srv]
        gpu_str = input(f"Enter GPU number for {srv}: ").strip()
        if not gpu_str.isdigit() or int(gpu_str) not in gset:
            print("❌ Invalid GPU number.")
            continue
        gnum = int(gpu_str)

        mapping_list = server_gpu[srv][gnum]
        for (leaf, iface, desc) in mapping_list:
            offset = len(interfaces)
            p64 = compute_prefix64(tenant_net, offset)
            rid = leaf_router_id.get(leaf, "0.0.0.0")
            rd_for_leaf = f"{rid}:{rd_counter}"

            # NOTE: interface keys in lower-case to match the Jinja template
            interfaces.append({
                "leaf": leaf,
                "iface": iface,
                "description": desc,
                "ipv6_prefix_64": str(p64)
            })

            print(f"✅ Added {iface} ({desc}) with prefix {p64} and RD {rd_for_leaf}")

        used_servers.add(srv)

    # Per-leaf RD map only (authoritative)
    leafs = sorted({i["leaf"] for i in interfaces})
    rd_map = {}
    for lf in leafs:
        rid = leaf_router_id.get(lf, "0.0.0.0")
        rd_map[lf] = f"{rid}:{rd_counter}"

    tenant = {
        "TENANT_NAME": tenant_name,
        "POLICY_NAME": f"BGP-AOS-Policy-{tenant_name}",
        "COMMUNITY_NAME": f"{tenant_name.upper()}_COMMUNITY_V6",
        "COMMUNITY_MEMBER_UNIQUE": f"210{idx:02}:26000",
        "VNI": str(vni_counter),
        "INTERFACES": interfaces,
        "ROUTE_DISTINGUISHER_MAP": rd_map,   # <-- only per-leaf map
        "VRF_TARGET": f"{vrf_counter}:1",
        "LEAF_NODES": leafs,
        "PREFIX_56": prefix_56
    }

    tenants.append(tenant)
    with open(YAML_OUT, "w") as f:
        yaml.dump({"tenants": tenants}, f, sort_keys=False)

    rows = []
    for i in interfaces:
        leaf = i["leaf"]
        rd_for_leaf = rd_map.get(leaf, "")
        rows.append([
            tenant_name,
            leaf,
            tenant["POLICY_NAME"],
            tenant["COMMUNITY_NAME"],
            tenant["VNI"],
            rd_for_leaf,
            tenant["VRF_TARGET"],
            prefix_56,
            f'{i["iface"]} ({i["description"]} {i["ipv6_prefix_64"]})'
        ])

    print("\n📋 Tenant summary:")
    print(tabulate(
        rows,
        headers=["Tenant","Leaf","Policy","Community","VNI","RD (per leaf)","VRF Target","RIO Prefix (/56)","Interfaces (/64)"]
    ))
    print(f"\n💾 Tenant '{tenant_name}' saved to {YAML_OUT} (Servers={len(used_servers)}, Prefix={prefix_56})")


if __name__ == "__main__":
    main()
Description
Interactive tenant creation tool designed to automate the definition of new tenants in an AI data center EVPN-VXLAN fabric.
It generates structured entries in a YAML file (tenants_dynamic.yaml) that describe the logical and addressing properties of each tenant, based on the physical connectivity between leaf switches and GPU servers.
This script eliminates manual YAML editing by programmatically assigning IPv6 prefixes, VNIs, VRFs, and per-leaf route distinguishers, ensuring consistency and avoiding address or ID overlap across the fabric.
